BOT_TOKEN=123456789:replace_with_botfather_token
CRYPTO_PAY_TOKEN=replace_with_cryptopay_app_token

# Numeric Telegram user IDs that may use /admin, /add_good and /stock.
# The bot sends these IDs a notification on every /start.
ADMIN_IDS=123456789

# Product prices in USD. Change them before going live.
GPT_PLUS_NW_PRICE_USD=1.63
GPT_PLUS_FW_PRICE_USD=3.75
PRO_5X_NW_PRICE_USD=20.63
PRO_20X_NW_PRICE_USD=41.88
GPT_PLUS_NW_PRICE_RUB=130
GPT_PLUS_FW_PRICE_RUB=300
PRO_5X_NW_PRICE_RUB=1650
PRO_20X_NW_PRICE_RUB=3350

# Crypto Pay will accept these assets for USD invoices.
CRYPTO_ACCEPTED_ASSETS=USDT,TON,BTC,ETH,LTC,BNB,TRX,USDC

SUPPORT_USERNAME=@codexrepIybot
# Text shown to users for support. The clickable link can point to another Telegram username.
SUPPORT_LABEL=@admingpt
SUPPORT_LINK=https://t.me/codexrepIybot
OFFER_LINK=https://telegra.ph/GPT-Codex-Shop-Terms-of-Sale-and-Public-Offer-08-05
PRIVACY_LINK=https://telegra.ph/GPT-Codex-Shop-Privacy-Policy-08-05
PAYMENT_POLL_SECONDS=15
CRYPTO_PAY_BASE_URL=https://pay.crypt.bot
# Optional. If empty, the app tries to use the system HTTPS proxy automatically.
TELEGRAM_PROXY=
DB_PATH=shop.sqlite3
DISPLAY_STOCK_GPT_PLUS_NW=4
DISPLAY_STOCK_GPT_PLUS_FW=4
DISPLAY_STOCK_PRO_5X_NW=6
DISPLAY_STOCK_PRO_20X_NW=1
# Marks a stock row 'sold' when the order is paid, so the same account can
# never reach a second buyer. The storefront counter is untouched: what buyers
# see is max(display stock, real accounts on hand).
DECREMENT_STOCK_ON_PAYMENT=true
# Quoted to the buyer when an order is paid before the accounts are loaded,
# so treat it as a promise rather than a guess.
PREORDER_DELIVERY_HOURS=24
CNY_PER_USD=7.20
RUB_PER_USD=80.00

# --- Manual cryptocurrency payment -----------------------------------------
# The receive-address table. Two mutually exclusive sources; inline wins.
#
#   CRYPTO_WALLETS       the table itself, multi-line. Use this in GitHub
#                        Actions, where the repository is public and the
#                        addresses must not be committed.
#   CRYPTO_WALLETS_FILE  path to the table on disk. Defaults to
#                        crypto_wallets.txt next to the bot. That file is
#                        gitignored on purpose.
#
# With neither source set the manual route is simply not offered and buyers
# still get the normal Crypto Pay invoice. Receive addresses only here - never
# a seed phrase or a private key.
CRYPTO_WALLETS=
CRYPTO_WALLETS_FILE=crypto_wallets.txt
# How long an unpaid request stays open before the bot clears it. Requests that
# already have a tx hash are never timed out - they wait for an admin.
MANUAL_CRYPTO_NOTE_HOURS=24
