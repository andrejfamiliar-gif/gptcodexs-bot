BOT_TOKEN=123456789:replace_with_botfather_token
XROCKET_PAY_TOKEN=replace_with_xrocket_bearer_token

# Numeric Telegram user IDs that may use /admin, /add_good and /stock.
# The bot sends these IDs a notification on every /start.
ADMIN_IDS=123456789

# Product prices in USD. Change them before going live.
GPT_PLUS_NW_PRICE_USD=1.63
GPT_PLUS_FW_PRICE_USD=3.75
PRO_5X_NW_PRICE_USD=20.63
PRO_20X_NW_PRICE_USD=41.88
GPT_PLUS_NW_PRICE_RUB=130
GPT_PLUS_FW_PRICE_RUB=300
PRO_5X_NW_PRICE_RUB=1650
PRO_20X_NW_PRICE_RUB=3350

# Asset used for xRocket invoices. Use the testnet asset/token pair while testing.
XROCKET_CURRENCY=USDT

SUPPORT_USERNAME=@codexrepIybot
# Text shown to users for support. The clickable link can point to another Telegram username.
SUPPORT_LABEL=@admingpt
SUPPORT_LINK=https://t.me/codexrepIybot
OFFER_LINK=https://telegra.ph/GPT-Codex-Shop-Terms-of-Sale-and-Public-Offer-08-05
PRIVACY_LINK=https://telegra.ph/GPT-Codex-Shop-Privacy-Policy-08-05
PAYMENT_POLL_SECONDS=15
XROCKET_PAY_BASE_URL=https://pay.api.xrocket.exchange
# Optional. If empty, the app tries to use the system HTTPS proxy automatically.
TELEGRAM_PROXY=
DB_PATH=shop.sqlite3
DISPLAY_STOCK_GPT_PLUS_NW=4
DISPLAY_STOCK_GPT_PLUS_FW=4
DISPLAY_STOCK_PRO_5X_NW=6
DISPLAY_STOCK_PRO_20X_NW=1
DECREMENT_STOCK_ON_PAYMENT=false
CNY_PER_USD=7.20
RUB_PER_USD=80.00
